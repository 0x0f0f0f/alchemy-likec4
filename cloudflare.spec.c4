  // ── bindings ──
  relationship service_binding {
    title 'Service binding'
    description 'Worker-to-Worker, in-account, no public hop'
  }
  relationship durable_object_binding {
    title 'Durable Object'
    description 'DO namespace, addressed by getByName'
  }
  relationship r2_binding {
    title 'R2'
    description 'Native bucket binding'
  }
  relationship d1_binding {
    title 'D1'
    description 'SQL database binding'
  }
  relationship kv_binding {
    title 'KV'
    description 'Key-value namespace binding'
  }
  relationship queue_binding {
    title 'Queue'
    description 'Producer binding'
  }
  relationship workflow_binding {
    title 'Workflow'
    description 'Workflow instance control'
  }
  relationship container_binding {
    title 'Container'
    description 'Container application, held by a DO'
  }
  relationship email_binding {
    title 'Email'
    description 'Cloudflare Email Sending'
  }
  relationship ai_binding {
    title 'AI'
    description 'Workers AI'
  }
  relationship secret {
    title 'Secret'
    description 'Encrypted Worker secret'
  }
  relationship var {
    title 'Var'
    description 'Plain Worker variable'
  }
