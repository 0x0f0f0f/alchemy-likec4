{
  "name": "alchemy-likec4",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "alchemy-likec4": "./src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "latest",
    "knip": "^6.36.0",
    "likec4": "1.59.3"
  },
  "peerDependencies": {
    "likec4": "^1.59.3",
    "typescript": "^7"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.77",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@likec4/core": "1.59.3",
    "@likec4/generators": "1.59.3",
    "alchemy": "^2.0.0-beta.77",
    "effect": "4.0.0-rc.112"
  },
  "overrides": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112"
  },
  "version": "0.1.0",
  "description": "Generate a LikeC4 specification from alchemy's resource registry",
  "scripts": {
    "generate": "bun run src/cli.ts spec",
    "validate": "bun run src/cli.ts spec --outdir .validate && likec4 validate --json --no-layout .validate",
    "example": "likec4 start example --port 5199",
    "example:generate": "bun run src/cli.ts deployment --entrypoint example/alchemy.run.ts --stage prod && bun run src/cli.ts deployment --entrypoint example/alchemy.run.ts --stage staging",
    "example:validate": "likec4 validate --json example",
    "test": "bun test",
    "lint": "biome check .",
    "check": "biome check . && knip",
    "prepublishOnly": "bun run check && bun run generate && bun run example:generate && bun test"
  },
  "files": [
    "specs",
    "src",
    "example",
    "index.ts",
    "README.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./vitest": "./src/vitest.ts",
    "./specs/*": "./specs/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "likec4",
    "alchemy",
    "architecture",
    "c4",
    "iac",
    "cloudflare"
  ],
  "license": "MIT"
}
