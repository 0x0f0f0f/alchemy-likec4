{
  "name": "alchemy-likec4",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "likec4": "1.59.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.77",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "alchemy": "^2.0.0-beta.77",
    "effect": "4.0.0-rc.112"
  },
  "overrides": {
    "effect": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112"
  },
  "version": "0.1.0",
  "description": "Generate a LikeC4 specification from alchemy's resource registry",
  "scripts": {
    "generate": "bun run index.ts",
    "validate": "bun run index.ts --outdir .validate && likec4 validate --json --no-layout .validate",
    "test": "bun test",
    "prepublishOnly": "bun run generate && bun test"
  },
  "files": [
    "specs",
    "src",
    "index.ts",
    "README.md"
  ],
  "exports": {
    "./specs/*": "./specs/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "likec4",
    "alchemy",
    "architecture",
    "c4",
    "iac",
    "cloudflare"
  ],
  "license": "MIT"
}
