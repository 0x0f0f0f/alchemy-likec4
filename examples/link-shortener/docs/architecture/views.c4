// The generated views (landscape, one per stage) live in ./alchemy. These are the hand-written
// ones: scoped, filtered and dynamic views that say something the generator cannot guess.
views {
  view index {
    title 'Shortener — landscape'
    include *
    include shortener.*
  }

  // A scoped view: `of` narrows it to one element and its neighbours.
  view inside of shortener {
    title 'Inside the shortener'
    include *
    // Style by tag, so the request path stands out from the async side.
    style element.tag = #hot-path { color green }
    style element.tag = #async { color amber; opacity 40% }
  }

  // Filtering with `where` — the modern predicate form.
  view request_path {
    title 'Request path only'
    include shortener.* where tag is #hot-path
    include visitor -> shortener.redirect
  }

  deployment view both_stages {
    title 'Both stages'
    include shortener_prod, shortener_prod.*
    include shortener_staging, shortener_staging.*
  }

  // A dynamic view: the steps are authored here and exist only in this view.
  dynamic view resolve {
    title 'Resolving a short link'
    variant sequence

    visitor -> shortener.redirect 'GET /abc123'
    alt {
      when 'cached' {
        shortener.redirect -> shortener.hot 'get(abc123)'
        shortener.redirect <- shortener.hot 'https://…'
      }
      else 'cold' {
        shortener.redirect -> shortener.hot 'get(abc123)'
        shortener.redirect <- shortener.hot 'miss'
        shortener.redirect -> shortener.links 'SELECT url WHERE slug = ?'
        shortener.redirect <- shortener.links 'https://…'
        shortener.redirect -> shortener.hot 'put, 1h ttl'
      }
    }
    visitor <- shortener.redirect '302 Location'

    opt 'fire and forget' {
      shortener.redirect -> shortener.clicks 'enqueue {slug, ts, ua}'
      shortener.clicks -> shortener.analytics 'batch of 100'
    }
  }
}
